{
  "format": 1,
  "name": "keyframe-qwen-image-2.1",
  "version": 4,
  "source": "Qwen-Image-2.1 keyframe from 1 to 6 references; the size of the picture is the size of image_1, which is scaled to the canvas, image_2 to image_6 to the smaller reference size. Every reference is loaded with its alpha (JoinImageWithAlpha), so RGBA cut-outs reach Qwen-Image-2.1, whose text encoder takes RGBA. With cutout on, BiRefNet (models/background_removal/birefnet.safetensors) removes the background of the drawn picture and it is saved as RGBA (E16). With cut_only on, nothing is drawn: BiRefNet cuts image_1 (scaled to the canvas) out as it is, so a person keeps the face of the photo 1:1 (E16, Denys).",
  "inputs": {
    "image_1": {
      "type": "image",
      "targets": [
