# Copy to .env. deploy/postgres.ps1 fills in the password for you.
MEMCRAFT_DATABASE_URL=postgresql+psycopg://memcraft:CHANGE_ME@127.0.0.1:5432/memcraft
# Uploads, previews and released videos: the only folder the web container sees.
MEMCRAFT_SHARED_DIR=C:\Source\MemcraftAI\data\shared
# Keyframes, latents, clips, Gemma copies: worker and ComfyUI only.
# Leave empty in the web container.
MEMCRAFT_PRIVATE_DIR=C:\Source\MemcraftAI\data\private
